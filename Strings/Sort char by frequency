class Solution {
public:
    string frequencySort(string s) {
        int freq[256] = {0};

        // Count frequency
        for(char c : s) {
    freq[(unsigned char)c]++;
}

        string ans = "";

        // Find highest frequency repeatedly
        for(int k = 0; k < 256; k++) {
            int maxFreq = 0;
            int index = -1;

            for(int i = 0; i < 256; i++) {
                if(freq[i] > maxFreq) {
                    maxFreq = freq[i];
                    index = i;
                }
            }

            if(index == -1)
                break;

            // Add character maxFreq times
            for(int j = 0; j < maxFreq; j++) {
                ans += char(index);
            }

            // Don't choose this character again
            freq[index] = 0;
        }

        return ans;
    }
};  
