Brute force----
class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {

        vector<int> ans;

        int n = nums1.size();
        int m = nums2.size();

        for(int i = 0; i < n; i++) {

            int greater = -1;

            for(int j = 0; j < m; j++) {

                if(nums1[i] == nums2[j]) {

                    for(int k = j + 1; k < m; k++) {

                        if(nums2[k] > nums2[j]) {
                            greater = nums2[k];
                            break;
                        }
                    }

                    break;
                }
            }

            ans.push_back(greater);
        }

        return ans;
    }
};



optimal(monotonic)
class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {

        vector<int> next(10001, -1);
        stack<int> st;

        for(int i = nums2.size() - 1; i >= 0; i--) {

            while(!st.empty() && st.top() < nums2[i]) {
                st.pop();
            }

            if(!st.empty()) {
                next[nums2[i]] = st.top();
            }

            st.push(nums2[i]);
        }

        vector<int> ans;

        for(int i = 0; i < nums1.size(); i++) {
            ans.push_back(next[nums1[i]]);
        }

        return ans;
    }
};
